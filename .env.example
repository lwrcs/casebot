# Required
ANTHROPIC_API_KEY=sk-ant-...
DISCORD_BOT_TOKEN=...
DATABASE_URL=postgresql://casebot:password@localhost:5432/casebot

# Generate with:
# python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=...

# Random string for OAuth CSRF protection
SECRET_KEY=...

# Google OAuth (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Set redirect URI to: http://localhost:8080/auth/google/callback (dev)
#                  or: https://yourdomain.com/auth/google/callback (prod)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Web server (publicly reachable URL for OAuth callbacks)
WEB_HOST=http://localhost:8080
WEB_PORT=8080

# For docker-compose
POSTGRES_PASSWORD=changeme

# Optional
CONVERSATION_HISTORY_TURNS=20
